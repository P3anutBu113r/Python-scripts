<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Workshop.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1450"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Joining" custom_title="0" dock_id="4" table="4,7:mainJoining"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Joining" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="79"/><column index="2" value="61"/><column index="3" value="69"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="People" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="60"/><column index="2" value="95"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Workshop" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="78"/><column index="2" value="103"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">select e.Name AS SessionName ,e.StartTime,e.Type, e.Location from Event e inner join EventParticipants ep On e.EventID = ep.EventID where ep. ParticipantID = 2 order by CAST(e.StartTime AS TIME) ASC</sql><sql name="SQL 2*">SELECT Event.Name, SUM(CASE WHEN EventParticipants.Arrived = 1 THEN 1 ELSE 0 END) AS PeopleArrived, 
SUM(CASE WHEN EventParticipants.Arrived = 0 THEN 1 ELSE 0 END) AS PeopleAway   
FROM Event INNER JOIN EventParticipants 
ON EventParticipants.EventID = Event.EventID
GROUP BY Event.EventID,  Event.Name;
</sql><sql name="SQL 3*">CREATE TABLE &quot;Customerfeedback&quot; (
	&quot;FeedbackID&quot;	INTEGER,
	&quot;Rating&quot;	INTEGER NOT NULL,
	&quot;extrafeedback&quot;	INTEGER,
	Check(Rating&lt;=5)
	PRIMARY KEY(&quot;FeedbackID&quot;)
);</sql><sql name="SQL 4*">INSERT into Customerfeedback VALUES(NULL, 7, &quot;yes&quot;)</sql><sql name="SQL 5*">select P.Name as PersonName, j.Completed from People p
 INNER join Joining j on p.PersonID=j.PersonID where j.WorkshopID = 1
</sql><sql name="SQL 6*">INSERT into Joining VALUES (1, 1, 0) </sql><sql name="SQL 7*">select Workshop.Name, sum(case when Joining.Completed = 1 then 1 else 0 END) as Completed
from Workshop inner JOIN Joining on Joining.WorkshopID = Workshop.WorkshopID
GROUP by Workshop.WorkshopID
	</sql><current_tab id="6"/></tab_sql></sqlb_project>
